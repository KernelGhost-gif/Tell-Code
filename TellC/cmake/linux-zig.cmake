set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${TELL_LINUX_ARCH}")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TELL_ZIG TELL_LINUX_ARCH)
set(zig_target "${TELL_LINUX_ARCH}-linux-musl")
set(CMAKE_C_COMPILER "${TELL_ZIG};cc;-target;${zig_target};-mcpu=baseline")
set(CMAKE_CXX_COMPILER "${TELL_ZIG};c++;-target;${zig_target};-mcpu=baseline")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -no-pie")
set(CMAKE_SKIP_RPATH TRUE)
# Zig 0.16.0 crashes on CMake's linker depfile flag for aarch64.
set(CMAKE_LINK_DEPENDS_USE_LINKER FALSE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
