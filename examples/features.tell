# A compact service report using lists, functions, decisions, loops, and math.
Let review_durations be [12, 18, 15, 21, 24].
Let target_duration be 20.

To calculate_average(values):
    Let total be 0.
    For each value in values:
        Set total to total plus value.
    End loop.
    Give back total divided by len(values).
End function.

Let average_duration be the result of calculate_average with review_durations.
Say "Average review time: {average_duration} days.".

If average_duration is at most target_duration:
    Say "The team is meeting the {target_duration}-day target.".
Otherwise:
    Say "The team is above the {target_duration}-day target.".
End if.

Let squared_deviation_total be 0.
For each duration in review_durations:
    Let difference be duration minus average_duration.
    Set squared_deviation_total to squared_deviation_total plus difference times difference.
End loop.

Use the math library as maths.
Let standard_deviation be maths.sqrt(squared_deviation_total divided by len(review_durations)).
Say "Variation across reviews: {standard_deviation} days.".

Repeat 3 times:
    Say "Quality checkpoint {the current repetition number} recorded.".
End repeat.
