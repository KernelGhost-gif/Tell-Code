# Requires Node.js on PATH and the node:path module.
Use the JavaScript library called node:path as paths.

Let release_directory be "/srv/apps/atlas/releases/2.4.0".
Let manifest_path be "/srv/apps/atlas/releases/2.4.0/manifest.json".
Say "Release manifest: {paths.basename(manifest_path)}".
Say "File type: {paths.extname(manifest_path)}".

# Named arguments are sent to JavaScript as a final options object.
Let generated_path be paths.format(dir=release_directory, name="manifest", ext=".json").
Say "Generated path: {generated_path}".
