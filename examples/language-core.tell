# Demonstrates Unicode identifiers, named arguments, and short-circuit logic.
To format_status with owner and status:
    Give back "{owner}: {status}.".
End function.

Let constant service_name as text be "Customer Portal".
Let évaluations as number be 2.

# The second operand is intentionally unsafe; short-circuiting keeps it unevaluated.
If false and (1 divided by 0 is equal to 0):
    Say "This branch should not run.".
Otherwise if évaluations is equal to 2:
    Say format_status(owner="Customer Operations", status="Ready for review").
Otherwise:
    Say "The review count needs attention.".
End if.

Say "Service: {service_name}; completed evaluations: {évaluations}.".
